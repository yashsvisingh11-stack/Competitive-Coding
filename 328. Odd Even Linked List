class Solution {
public:
    ListNode* oddEvenList(ListNode* head) {
        
        if (head == NULL || head->next == NULL) {
            return head;
        }

        ListNode* odd = head;
        ListNode* even = head->next;
        ListNode* evenHead = even;

        while (even != NULL && even->next != NULL) {
            
            odd->next = even->next;
            odd = odd->next;

            even->next = odd->next;
            even = even->next;
        }

        
        odd->next = evenHead;

        return head;
    }
};

Procedure:
1. Check if the list has 0 or 1 node; if yes, return head.
2. Set three pointers: odd = head, even = head->next, and evenHead = even.
3. Traverse the list while even and even->next are not NULL.
4. Connect odd nodes: odd->next = even->next, then move odd.
5. Connect even nodes: even->next = odd->next, then move even.
6. Repeat until the end.
7. Connect the odd list to the even list using odd->next = evenHead.
8. Return head.

Complexity:
Time: O(n)
Space: O(1)
