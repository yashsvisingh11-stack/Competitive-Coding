class Solution {
public:
    bool isPalindrome(ListNode* head) {
        
        ListNode* slow = head;
        ListNode* fast = head;

        while (fast != NULL && fast->next != NULL) {
            slow = slow->next;
            fast = fast->next->next;
        }

        ListNode* prev = NULL;
        ListNode* curr = slow;

        while (curr != NULL) {
            ListNode* nextNode = curr->next;
            curr->next = prev;
            prev = curr;
            curr = nextNode;
        }

        ListNode* first = head;
        ListNode* second = prev;

        while (second != NULL) {
            if (first->val != second->val) {
                return false;
            }

            first = first->next;
            second = second->next;
        }

        return true;
    }
};


Procedures:
1. Find the middle of the linked list using slow and fast pointers.
2. Reverse the second half of the list.
3. Set pointers at the beginning of the first half and the reversed second half.
4. Compare the values of both halves.
5. If any values are different, return false.
6. If all values match, return true.

Complexity:
Time: O(n)
Space: O(1)
